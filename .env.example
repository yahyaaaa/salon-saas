# -----------------------------------------------------------------------------
# Supabase
# Project Settings -> Data API  (URL)  and  Project Settings -> API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Publishable ("sb_publishable_...") key. If your project still uses the legacy
# key pair, set NEXT_PUBLIC_SUPABASE_ANON_KEY instead -- either one works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Secret ("sb_secret_...") or legacy service_role key. SERVER ONLY -- this key
# bypasses Row Level Security. Never expose it to the browser, never prefix it
# with NEXT_PUBLIC_. Used only for the staff invite flow in Phase 1.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public origin used to build auth redirect links (invites, email confirmation).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Tenant isolation test script (npm run test:rls) -- see scripts/test-rls.mjs
# Uses the keys above; no extra configuration needed.
# -----------------------------------------------------------------------------
